{
  "name": "@usenotra/agentside",
  "version": "0.3.4",
  "description": "Serve markdown to AI agents and A/B test what they read. Built on Effect. By Notra.",
  "keywords": [
    "ai",
    "agents",
    "markdown",
    "llms",
    "geo",
    "aeo",
    "content-negotiation",
    "effect"
  ],
  "license": "MIT",
  "homepage": "https://agentside.usenotra.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usenotra/agentside.git",
    "directory": "packages/agentside"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "default": "./dist/effect.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "effect": "4.1.2",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "node-html-markdown": "2.0.0",
    "node-html-parser": "6.1.13"
  }
}
