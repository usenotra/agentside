---
import { Code } from "astro:components";
import "../styles/global.css";

const GITHUB_URL = "https://github.com/usenotra/agentside";
const NPM_URL = "https://www.npmjs.com/package/@usenotra/agentside";
const DOCS_URL = "/docs";
const NOTRA_URL = "https://usenotra.com";
const BENCHMARKS_URL = `${GITHUB_URL}#benchmarks`;
const RELEASE_URL = `${GITHUB_URL}#static-sites-convert-your-built-html`;
const INSTALL_COMMAND = "npm install @usenotra/agentside";
const SITE_URL = "https://agentside.usenotra.com";
const OG_IMAGE_URL = `${SITE_URL}/og.jpg`;

const title = "Agentside by Notra: markdown twins for AI agents";
const description =
  "Agentside serves a markdown version of your pages to AI agents and lets you A/B test what each agent reads. It is built on Effect and runs anywhere that speaks fetch.";

const themes = { light: "github-light", dark: "github-dark" };

const setup = `import { agentside, remote } from "@usenotra/agentside";

export const twins = agentside({
  routes: {
    "/": "# Acme\\n\\nAcme sends invoices your customers actually pay.",
    "/pricing": () => renderPricingMarkdown(),
    "/blog/[slug]": ({ params }) => getPost(params.slug)?.markdown ?? null,
    "/docs/[...path]": remote(({ params }) => \`https://cms.acme.dev/docs/\${params.path}.md\`),
  },
  skip: ["/api", "/assets"],
});

export const onRequest = (context, next) => twins.handle(context.request, () => next());`;

const variants = `agentside({
  routes: { "/pricing": () => renderPricingMarkdown() },
  variants: {
    "/pricing": [
      { id: "pricing-search", purposes: ["search"], source: remote("https://cms.acme.dev/pricing-v2.md") },
      { id: "pricing-short", agents: ["ChatGPT-User", "Claude-User"], source: shortPricing },
    ],
  },
  onServe: (event) => analytics.track("agent_read", event),
});`;

const exposure = `{
  "path": "/pricing",
  "variant": "pricing-search",
  "agent": { "name": "OAI-SearchBot", "vendor": "OpenAI", "purpose": "search" },
  "status": 200,
  "cached": true,
  "durationMs": 0.21
}`;

const browserExchange = [
  ["req", "GET /pricing"],
  ["head", "Accept: text/html"],
  ["head", "User-Agent: Mozilla/5.0 (Macintosh) Safari/605.1.15"],
  ["gap", ""],
  ["status", "200 OK"],
  ["head", "Content-Type: text/html; charset=utf-8"],
  ["mark", 'Link: </pricing.md>; rel="alternate"; type="text/markdown"'],
  ["head", "Vary: Accept"],
  ["gap", ""],
  ["body", "<!doctype html>"],
  ["body", '<html lang="en">'],
  ["body", "  <head>"],
  ["body", "    <title>Pricing</title>"],
  ["body", '    <link rel="stylesheet" href="/assets/app.css" />'],
  ["body", "  </head>"],
  ["body", "  <body>"],
  ["body", '    <div id="app">'],
];

const agentExchange = [
  ["req", "GET /pricing"],
  ["head", "Accept: */*"],
  ["mark", "User-Agent: GPTBot/1.2"],
  ["gap", ""],
  ["status", "200 OK"],
  ["mark", "Content-Type: text/markdown; charset=utf-8"],
  ["head", "X-Markdown-Tokens: 212"],
  ["head", "Vary: Accept, User-Agent"],
  ["gap", ""],
  ["body", "# Pricing"],
  ["body", ""],
  ["body", "Acme sends invoices your customers actually pay."],
  ["body", ""],
  ["body", "| Plan    | Price         | Invoices  |"],
  ["body", "| ------- | ------------- | --------- |"],
  ["body", "| Starter | $0 a month    | 20        |"],
  ["body", "| Team    | $49 a month   | Unlimited |"],
];

const features = [
  {
    title: "Content negotiation",
    body: "A request gets markdown when its path ends in .md, when its Accept header prefers text/markdown or when its user agent belongs to a known AI agent, and every other request gets your HTML page.",
    frameTitle: "Requests to /pricing",
    frameSub: "Six requests and the response each one receives",
    headers: ["Request", "Response"],
    mono: [true, false],
    rows: [
      ["GET /pricing.md", "text/markdown"],
      ["Accept: text/markdown", "text/markdown"],
      ["User-Agent: GPTBot/1.2", "text/markdown"],
      ["Accept: text/html", "text/html with a Link header"],
      ["Accept: application/json", "406 Not Acceptable"],
      ["POST /pricing", "Passed to your app"],
    ],
  },
  {
    title: "Agent detection",
    body: "Agentside matches the user agent against a list of known AI agents and tags each match with a vendor and a purpose, and you can target variants at any of those tags.",
    frameTitle: "Known agents",
    frameSub: "A sample of the list that ships with the package",
    headers: ["Agent", "Vendor", "Purpose"],
    mono: [true, false, false],
    rows: [
      ["ChatGPT-User", "OpenAI", "User action"],
      ["OAI-SearchBot", "OpenAI", "Search"],
      ["GPTBot", "OpenAI", "Training"],
      ["Claude-User", "Anthropic", "User action"],
      ["ClaudeBot", "Anthropic", "Training"],
      ["PerplexityBot", "Perplexity", "Search"],
      ["Google-Extended", "Google", "Training"],
    ],
  },
  {
    title: "Variants per agent",
    body: "A route can carry a list of variants that target agents by name, vendor or purpose. Agentside serves the first variant that matches and names it in the X-Agentside-Variant header.",
    frameTitle: "Variants on /pricing",
    frameSub: "Agentside checks them from top to bottom",
    headers: ["Variant", "Served to", "Source"],
    mono: [true, false, false],
    rows: [
      ["pricing-search", "Search agents", "pricing-v2.md on the CMS"],
      ["pricing-short", "ChatGPT-User and Claude-User", "shortPricing"],
      ["control", "Every other agent", "renderPricingMarkdown()"],
    ],
  },
  {
    title: "Fallbacks for broken twins",
    body: "Each source runs inside Effect with retries and a timeout. When a twin fails, a negotiated request gets your HTML page and an explicit .md request gets a markdown 404 or 503.",
    frameTitle: "When a twin fails",
    frameSub: "What the agent receives in each case",
    headers: ["Situation", "Response"],
    mono: [false, false],
    rows: [
      ["The variant source throws", "The control twin"],
      ["The twin render throws", "Your HTML page with a 200"],
      ["The page has no twin", "Your HTML page with a 200"],
      ["A .md URL has no twin", "404 as markdown"],
      ["A .md render throws", "503 with Retry-After"],
      ["A remote source hangs", "503 after the timeout"],
    ],
  },
];

const faq = [
  {
    question: "Which frameworks does Agentside run in?",
    answer:
      "The handler takes a standard Request and returns a standard Response, so it runs in TanStack Start, Astro, Hono, Next.js middleware, Bun and Workers, and the docs have a guide for each of them.",
  },
  {
    question: "Do I have to write the markdown by hand?",
    answer:
      "You can skip that step on a static site, because prerenderHtml reads every built .html file, converts the main element to markdown and writes the result next to the page. The same call writes llms.txt and llms-full.txt for the whole site.",
  },
  {
    question: "What changes for people who visit in a browser?",
    answer:
      "Browsers get your HTML page untouched, and when a twin exists the response carries a Link header that points agents at the markdown version of the same URL.",
  },
  {
    question: "How does Agentside recognise an AI agent?",
    answer:
      "It matches the user agent against a built-in list that includes GPTBot, ClaudeBot and PerplexityBot, and it tags each match with a vendor and a purpose. A client that is missing from the list still gets markdown when it sends Accept: text/markdown or requests a .md URL.",
  },
  {
    question: "Do I need to know Effect to use it?",
    answer:
      "The default import is a plain function that takes a Request, so you can use Agentside without writing any Effect code. Teams that want the Effect program and its typed errors can import them from @usenotra/agentside/effect.",
  },
  {
    question: "How do I move over from Dualmark?",
    answer:
      "The migration guide in the docs maps a Dualmark route handler and middleware to Agentside routes and a single handle call, which removes the rewrite, the internal /md route and generateStaticParams.",
  },
  {
    question: "What does Agentside cost?",
    answer:
      "Agentside is free and open source under the MIT license, and you install it from npm as @usenotra/agentside.",
  },
];

const footerColumns = [
  {
    heading: "Docs",
    links: [
      { label: "Quickstart", href: `${DOCS_URL}/quickstart` },
      { label: "Routes and sources", href: `${DOCS_URL}/routes` },
      { label: "Content negotiation", href: `${DOCS_URL}/negotiation` },
      { label: "A/B variants", href: `${DOCS_URL}/variants` },
      { label: "Error handling", href: `${DOCS_URL}/error-handling` },
    ],
  },
  {
    heading: "Frameworks",
    links: [
      { label: "Next.js", href: `${DOCS_URL}/frameworks/nextjs` },
      { label: "Astro", href: `${DOCS_URL}/frameworks/astro` },
      { label: "TanStack Start", href: `${DOCS_URL}/frameworks/tanstack-start` },
      { label: "Hono", href: `${DOCS_URL}/frameworks/hono` },
      { label: "Workers and Bun", href: `${DOCS_URL}/frameworks/workers-and-bun` },
    ],
  },
  {
    heading: "Project",
    links: [
      { label: "GitHub", href: GITHUB_URL },
      { label: "npm", href: NPM_URL },
      { label: "Benchmark harness", href: BENCHMARKS_URL },
      { label: "Migrate from Dualmark", href: `${DOCS_URL}/migrating-from-dualmark` },
      { label: "Notra", href: NOTRA_URL },
    ],
  },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={OG_IMAGE_URL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Agentside. Serve AI agents a markdown version of every page." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={OG_IMAGE_URL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="announcement" href={RELEASE_URL}>
      <span>Agentside now converts your built HTML to markdown and writes llms.txt for you</span>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path d="M3 8h10m0 0L9 4m4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>

    <header class="site-header">
      <a class="brand" href="/" aria-label="Agentside home">
        <img src="/logo.svg" alt="" width="28" height="28" />
        <span>Agentside</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#features">Features</a>
        <a href="#benchmarks">Benchmarks</a>
        <a href="#faq">FAQ</a>
        <a href={GITHUB_URL}>GitHub</a>
      </nav>
      <div class="header-actions">
        <a class="pill" href={DOCS_URL}>Read the docs</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-panel">
          <canvas class="dither" data-dither aria-hidden="true"></canvas>
          <div class="hero-copy">
            <h1>Serve AI agents a markdown version of every page.</h1>
            <p class="lede">
              Agentside is a TypeScript library that answers ChatGPT, Claude and Perplexity with a markdown twin of the
              page they asked for, and it lets you A/B test what each agent reads.
            </p>
            <div class="install">
              <span class="prompt" aria-hidden="true">$</span>
              <code>{INSTALL_COMMAND}</code>
              <button class="copy-button" type="button" data-copy={INSTALL_COMMAND}>Copy</button>
            </div>
            <p class="hero-links">
              <a href={`${DOCS_URL}/quickstart`}>Read the quickstart</a>
              <a href={GITHUB_URL}>View the source on GitHub</a>
            </p>
          </div>

          <div class="demo">
            <div class="exchange">
              <p class="exchange-title"><span class="dot"></span>A browser requests /pricing</p>
              <pre data-language="http">{browserExchange.map(([kind, text]) => <span class:list={["line", kind]}>{text}</span>)}</pre>
            </div>
            <div class="exchange">
              <p class="exchange-title"><span class="dot agent"></span>GPTBot requests the same URL</p>
              <pre data-language="http">{agentExchange.map(([kind, text]) => <span class:list={["line", kind]}>{text}</span>)}</pre>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="features">
        <div class="wrap">
          <header class="section-head">
            <h2>One URL serves people and agents.</h2>
            <p>
              Agentside reads the path, the Accept header and the user agent of each request, and then it decides
              whether the visitor gets your HTML page or its markdown twin.
            </p>
          </header>
          <div class="feature-grid">
            {
              features.map((feature) => (
                <article class="feature">
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                  <div class="feature-stage">
                    <div class="frame">
                      <p class="frame-title">{feature.frameTitle}</p>
                      <p class="frame-sub">{feature.frameSub}</p>
                      <div class="frame-table">
                        <table>
                          <thead>
                            <tr>
                              {feature.headers.map((header) => (
                                <th scope="col">{header}</th>
                              ))}
                            </tr>
                          </thead>
                          <tbody>
                            {feature.rows.map((row) => (
                              <tr>
                                {row.map((cell, index) => (
                                  <td class={feature.mono[index] ? "mono" : undefined}>{cell}</td>
                                ))}
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="setup">
        <div class="wrap">
          <header class="section-head">
            <h2>Describe your twins in one file.</h2>
            <p>
              A route maps a path to a source, and the handler takes a standard Request and returns a standard
              Response, which lets the same config run in server middleware, an edge worker or a plain fetch handler.
            </p>
          </header>
          <div class="split">
            <div class="copy">
              <h3>Routes and sources</h3>
              <p>
                A source is a string, a function that returns markdown or a remote URL that Agentside fetches with a
                timeout and retries. When a function returns null the page has no twin, and Agentside passes the
                request to your app.
              </p>
              <a class="text-link" href={`${DOCS_URL}/routes`}>Read about routes and sources</a>
            </div>
            <div class="code-card">
              <div class="code-title">middleware.ts</div>
              <Code code={setup} lang="ts" themes={themes} defaultColor="light" />
            </div>
          </div>
          <div class="split">
            <div class="copy">
              <h3>Test what each agent reads</h3>
              <p>
                The onServe callback hands you an exposure event for each read, with the path, the variant, the agent
                and the response status. A GEO team can join those events with the citations and answers that follow.
              </p>
              <a class="text-link" href={`${DOCS_URL}/variants`}>Read about A/B variants</a>
            </div>
            <div class="stack">
              <div class="code-card">
                <div class="code-title">variants</div>
                <Code code={variants} lang="ts" themes={themes} defaultColor="light" />
              </div>
              <div class="code-card">
                <div class="code-title">onServe event</div>
                <Code code={exposure} lang="json" themes={themes} defaultColor="light" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="benchmarks">
        <div class="wrap">
          <header class="section-head">
            <h2>Benchmarks against Dualmark and a homegrown setup.</h2>
            <p>
              Agentside and Dualmark 0.11 ran through the same harness on Bun 1.4 and an Apple M5, and lower numbers
              are better. The AI Inbx column is their own measurement of a homegrown setup on a 39 KB pricing page, so
              treat it as indicative.
            </p>
          </header>
          <div class="table-scroll">
            <table class="bench-table">
              <thead>
                <tr>
                  <th scope="col">Scenario</th>
                  <th scope="col">
                    <span class="vendor"><img src="/logo.svg" alt="" width="20" height="20" />Agentside</span>
                  </th>
                  <th scope="col"><span class="vendor">AI Inbx (homegrown)</span></th>
                  <th scope="col">
                    <span class="vendor"><img src="/dodo-payments.svg" alt="" width="20" height="20" />Dualmark by Dodo Payments</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">Agent gets a markdown page, cached</th>
                  <td class="best">2.67 µs</td>
                  <td>2.89 µs</td>
                  <td>41.2 µs (no cache)</td>
                </tr>
                <tr>
                  <th scope="row">Agent gets a markdown page, cache off</th>
                  <td class="best">15.4 µs</td>
                  <td>3.3 ms</td>
                  <td>41.2 µs</td>
                </tr>
                <tr>
                  <th scope="row">Agent detection</th>
                  <td class="best">~50 ns</td>
                  <td>160 to 240 ns</td>
                  <td>~500 ns</td>
                </tr>
                <tr>
                  <th scope="row">Browser request getting HTML</th>
                  <td class="best">1.47 µs</td>
                  <td>20.5 µs</td>
                  <td>2.26 µs</td>
                </tr>
                <tr>
                  <th scope="row">Agent hits a page whose render throws</th>
                  <td class="best">Serves the HTML page</td>
                  <td>500</td>
                  <td>Request throws</td>
                </tr>
                <tr>
                  <th scope="row">Agent hits a page with no markdown version</th>
                  <td class="best">Serves the HTML page</td>
                  <td>HTML page, or 406 for <code>Accept: text/markdown</code> alone</td>
                  <td>404</td>
                </tr>
                <tr>
                  <th scope="row">Prerender twins to static files</th>
                  <td class="best"><code>agentside/build</code>, fails the build on errors</td>
                  <td>Yes, fails the build on errors</td>
                  <td>Next.js static params only</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="bench-aside">
            A network round trip to your server takes thousands of times longer than any number in this table, so
            these latencies will not change how fast an agent gets your page, and we optimized them anyway. You can
            <a class="text-link" href={BENCHMARKS_URL}>run the benchmark harness yourself</a> to check them.
          </p>
        </div>
      </section>

      <section class="section" id="faq">
        <div class="wrap faq-wrap">
          <header class="section-head">
            <h2>Questions people ask before they install.</h2>
          </header>
          <div class="faq">
            {
              faq.map((item, index) => (
                <details open={index === 0}>
                  <summary>
                    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <path d="M20 12H4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                      <path class="bar" d="M12 4v16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <span>{item.question}</span>
                  </summary>
                  <p>{item.answer}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section cta-section">
        <div class="cta-banner">
          <canvas class="dither" data-dither aria-hidden="true"></canvas>
          <div class="cta-inner">
            <h2>Start serving markdown to the agents that read your site.</h2>
            <p>
              The quickstart takes you from the install command to a first markdown response, and the docs cover each
              framework and the move from Dualmark.
            </p>
            <div class="actions">
              <a class="cta primary" href={`${DOCS_URL}/quickstart`}>Read the quickstart</a>
              <a class="cta light" href={`${DOCS_URL}/migrating-from-dualmark`}>Migrate from Dualmark</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="Agentside home">
            <img src="/logo.svg" alt="" width="28" height="28" />
            <span>Agentside</span>
          </a>
          <p>
            Agentside is an open source library from <a href={NOTRA_URL}>Notra</a> that serves markdown versions of
            your pages to AI agents.
          </p>
        </div>
        {
          footerColumns.map((column) => (
            <nav aria-label={column.heading}>
              <p class="footer-heading">{column.heading}</p>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
      <p class="footer-legal">© {year} Notra, Inc. Agentside ships under the MIT license.</p>
    </footer>

    <script>
      const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
      const CELL = 3;
      const FRAME_MS = 90;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function startDither(canvas: HTMLCanvasElement) {
        const context = canvas.getContext("2d");
        if (!context) return;
        let width = 0;
        let height = 0;
        let image: ImageData | null = null;
        let visible = false;
        let last = 0;

        function resize() {
          width = Math.max(1, Math.ceil(canvas.clientWidth / CELL));
          height = Math.max(1, Math.ceil(canvas.clientHeight / CELL));
          canvas.width = width;
          canvas.height = height;
          image = context!.createImageData(width, height);
          draw(performance.now());
        }

        function draw(now: number) {
          if (!image) return;
          const time = now * 0.00035;
          const data = image.data;
          for (let y = 0; y < height; y++) {
            const drift = 1.4 * Math.sin(y * 0.021 + time * 1.3);
            for (let x = 0; x < width; x++) {
              const wave = 0.5 + 0.5 * Math.sin(x * 0.018 + drift + time) * Math.cos(y * 0.013 - time * 0.7);
              const threshold = (BAYER[(y & 3) * 4 + (x & 3)] + 0.5) / 16;
              const offset = (y * width + x) * 4;
              data[offset] = 139;
              data[offset + 1] = 92;
              data[offset + 2] = 246;
              data[offset + 3] = wave * 0.5 > threshold ? 30 : 0;
            }
          }
          context!.putImageData(image, 0, 0);
        }

        function tick(now: number) {
          if (!visible) return;
          if (now - last >= FRAME_MS) {
            last = now;
            draw(now);
          }
          requestAnimationFrame(tick);
        }

        new ResizeObserver(resize).observe(canvas);
        if (reduceMotion) return;
        new IntersectionObserver(([entry]) => {
          const wasVisible = visible;
          visible = entry.isIntersecting;
          if (visible && !wasVisible) requestAnimationFrame(tick);
        }).observe(canvas);
      }

      document.querySelectorAll<HTMLCanvasElement>("canvas[data-dither]").forEach(startDither);

      document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((button) => {
        const label = button.textContent;
        button.addEventListener("click", async () => {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
          button.textContent = "Copied";
          window.setTimeout(() => {
            button.textContent = label;
          }, 1600);
        });
      });
    </script>
  </body>
</html>

<style>
  .wrap {
    width: 100%;
