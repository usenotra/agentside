---
import { NAV_LINKS } from "../../constants/navigation";
import { DOCS_URL } from "../../constants/site";
import Brand from "../ui/Brand.astro";
---

<header class="site-header">
  <Brand />
  <nav class="nav" aria-label="Main">
    {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <div class="header-actions">
    <a class="pill" href={DOCS_URL}>Read the docs</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 1rem;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: calc(100% - 2rem);
    max-width: 64rem;
    height: 4rem;
    margin: 2.25rem auto 0;
    padding: 0 1.5rem;
    border-radius: 1.25rem;
    background: var(--surface);
    box-shadow: var(--island-shadow);
  }

  @media (min-width: 48rem) {
    .site-header {
      width: calc(100% - 6rem);
    }
  }

  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-rest linear both;
    }

    /* A separate selector stops the minifier from folding the timeline into the shorthand, which Chrome rejects. */
    header.site-header {
      animation-timeline: scroll(root);
      animation-range: 0 10rem;
    }
  }

  @keyframes header-rest {
    from {
      max-width: 90rem;
      background: transparent;
      box-shadow: none;
    }
  }

  .nav {
    display: none;
    gap: 2.25rem;
    font-size: 1rem;
    font-weight: 500;
  }

  @media (min-width: 56rem) {
    .nav {
      display: flex;
    }
  }

  .nav a {
    color: var(--soft);
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  .nav a:hover {
    color: var(--text);
  }

  .header-actions {
    grid-column: 3;
    justify-self: end;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.75rem;
    border-radius: 0.625rem;
    background: var(--surface);
    box-shadow:
      0 0.0625rem 0.125rem #28282814,
      0 0 0 1px var(--hairline);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      animation: none;
    }

    .nav a {
      transition: none;
    }
  }
</style>
