---
import type { FeatureCardProps } from "../../types/landing";
import { isVendor } from "../../utils/vendors";
import VendorLogo from "../ui/logos/VendorLogo.astro";
import MockFrame from "./MockFrame.astro";

type Props = FeatureCardProps;

const { feature } = Astro.props;
---

<article class="feature">
  <h3>{feature.title}</h3>
  <p>{feature.body}</p>
  <div class="stage">
    <MockFrame title={feature.frameTitle} subtitle={feature.frameSub}>
      <table>
        <thead>
          <tr>
            {feature.headers.map((header) => <th scope="col">{header}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            feature.rows.map((row) => (
              <tr>
                {row.map((cell, index) => (
                  <td class={feature.mono[index] ? "mono" : undefined}>
                    {index === feature.vendorColumn && isVendor(cell) ? (
                      <span class="vendor">
                        <VendorLogo vendor={cell} />
                        {cell}
                      </span>
                    ) : (
                      cell
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </MockFrame>
  </div>
</article>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.25rem;
    overflow: clip;
    border-radius: 0.8125rem;
    background: var(--card-bg);
    box-shadow:
      0 0.0625rem 0.125rem #0a0d1408,
      0 0 0 1px var(--ring);
  }

  @media (min-width: 40rem) {
    .feature {
      padding: 2.1875rem;
    }
  }

  .feature > p {
    max-width: 34rem;
    margin: 0.375rem 0 0;
    color: var(--muted);
    font-weight: 500;
    text-wrap: pretty;
  }

  /*
   * The stage clips and fades the mock frame at the bottom. It reaches 1.5rem past the frame on
   * the top and sides (negative margin, matching padding) so the frame's drop shadow fits inside
   * the clip instead of being cut off in a hard square at the corners.
   */
  .stage {
    height: 21.5rem;
    margin: 0 -1.5rem;
    padding: 1.5rem 1.5rem 0;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, black calc(100% - 4.5rem), transparent);
  }

  @media (min-width: 40rem) {
    .stage {
      height: 25rem;
      margin-top: 0.5rem;
    }
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  th {
    height: 2.5rem;
    padding: 0 0.75rem;
    background: var(--muted-surface);
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    text-align: left;
    white-space: nowrap;
  }

  td {
    height: 2.75rem;
    padding: 0.375rem 0.75rem;
    border-top: 1px solid var(--border);
    line-height: 1.25rem;
  }

  td.mono {
    font-family: var(--mono);
    font-size: 0.78125rem;
    white-space: nowrap;
  }

  td:not(:first-child) {
    color: var(--soft);
  }

  /* A block-level flex row, so the logo doesn't become the baseline and lift the text. */
  .vendor {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
</style>
