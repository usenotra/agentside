---
// Copy button in the style of the Notra copy buttons: the copy icon and label
// cross-fade to a tick and "Copied" for a moment, and the button keeps its width.
// A successful copy also bursts a few sparkles out of the button.
import type { CopyButtonProps } from "../../types/ui";
import CtaButton from "./CtaButton.astro";

type Props = CopyButtonProps;

const { text, label } = Astro.props;
---

<span class="copy-root" data-copy-root>
  <CtaButton
    variant="flat"
    size="sm"
    class="copy-button"
    aria-label={label}
    data-copy={text}
    data-label={label}
    data-copy-button
  >
    <span class="faces" data-copy-faces>
      <span class="face idle">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path
            d="M7.5 14.5C7.5 11.2002 7.5 9.55025 8.52513 8.52513C9.55025 7.5 11.2002 7.5 14.5 7.5C17.7998 7.5 19.4497 7.5 20.4749 8.52513C21.5 9.55025 21.5 11.2002 21.5 14.5C21.5 17.7998 21.5 19.4497 20.4749 20.4749C19.4497 21.5 17.7998 21.5 14.5 21.5C11.2002 21.5 9.55025 21.5 8.52513 20.4749C7.5 19.4497 7.5 17.7998 7.5 14.5Z"
          ></path>
          <path
            d="M7.5 16.5C6.10355 16.5 5.40533 16.5 4.84402 16.3036C3.83866 15.9518 3.0482 15.1613 2.69641 14.156C2.5 13.5947 2.5 12.8964 2.5 11.5V9.5C2.5 6.20017 2.5 4.55025 3.52513 3.52513C4.55025 2.5 6.20017 2.5 9.5 2.5H11.5C12.8964 2.5 13.5947 2.5 14.156 2.69641C15.1613 3.0482 15.9518 3.83866 16.3036 4.84402C16.5 5.40533 16.5 6.10355 16.5 7.5"
          ></path>
        </svg>
        <span class="text">Copy</span>
      </span>
      <span class="face done" aria-hidden="true">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 14L8.5 17.5L19 6.5"></path></svg>
        <span class="text">Copied</span>
      </span>
    </span>
  </CtaButton>
  <span class="sr-only" role="status" data-copy-status></span>
</span>

<style>
  .copy-root {
    display: contents;
  }

  .faces {
    display: grid;
  }

  .face {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    /* Returning to "Copy" is the unhurried direction: a soft cross-fade on Notra's button-swap curve. */
    transition-property: opacity, transform, filter;
    transition-duration: 320ms;
    transition-timing-function: cubic-bezier(0.45, 0, 0.25, 1);
  }

  /* "Copy" waits a beat so it arrives as "Copied" is already on its way out. */
  .idle {
    transition-delay: 80ms;
  }

  /* Showing "Copied" stays snappy, since it is direct feedback to the click. */
  .faces[data-copied] .face {
    transition-duration: 100ms;
    transition-delay: 0ms;
    transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
  }

  .face svg {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .done {
    opacity: 0;
    transform: translateY(0.375rem);
    filter: blur(2px);
  }

  .faces[data-copied] .idle {
    opacity: 0;
    transform: translateY(-0.375rem);
    filter: blur(2px);
  }

  .faces[data-copied] .done {
    opacity: 1;
    transform: none;
    filter: none;
  }

  /* Created by burstSparkles at runtime, so they carry no scope attribute. */
  :global(.copy-sparkle) {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    pointer-events: none;
    will-change: transform, opacity;
  }

  /* Icon only on narrow screens so the install command keeps its room. */
  @media (max-width: 29.99rem) {
    .copy-button {
      --cta-padding-x: 0.6875rem;
    }

    .text {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .face,
    .done,
    .faces[data-copied] .idle {
      transform: none;
      filter: none;
    }
  }
</style>

<script>
  import { COPIED_STATE_DURATION_MS } from "../../constants/copy-button";
  import { copyToClipboard } from "../../utils/copy-to-clipboard";
  import { burstSparkles } from "../../utils/sparkles";

  document.querySelectorAll<HTMLElement>("[data-copy-root]").forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>("[data-copy-button]");
    const faces = root.querySelector<HTMLElement>("[data-copy-faces]");
    const status = root.querySelector<HTMLElement>("[data-copy-status]");
    if (!button || !faces || !status) return;
    const label = button.dataset.label ?? "Copy";
    let timer: number | undefined;

    function reset() {
      delete faces!.dataset.copied;
      button!.setAttribute("aria-label", label);
      status!.textContent = "";
    }

    button.addEventListener("click", async () => {
      const copied = await copyToClipboard(button.dataset.copy ?? "");
      window.clearTimeout(timer);
      if (!copied) {
        reset();
        status.textContent = "Copying failed. Select the text and copy it by hand.";
        return;
      }
      faces.dataset.copied = "";
      burstSparkles(button);
      button.setAttribute("aria-label", "Copied");
      status.textContent = "Copied to the clipboard";
      timer = window.setTimeout(reset, COPIED_STATE_DURATION_MS);
    });
  });
</script>
