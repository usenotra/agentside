---
// Port of the Notra CtaButton (@notra/ui/components/shared/cta-button).
// "primary" carries the violet halo and is for standalone calls to action.
// "flat" drops the halo so it fits inside another control, such as the install pill.
import type { CtaButtonProps } from "../../types/ui";

type Props = CtaButtonProps;

const { variant = "primary", size = "lg", href, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag class:list={["cta-button", variant, size, className]} href={href} type={href ? undefined : "button"} {...rest}>
  <slot />
</Tag>

<style>
  .cta-button {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 0;
    border-radius: 999px;
    font-family: var(--sans);
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    transition:
      --cta-gradient-from 200ms ease-out,
      --cta-gradient-to 200ms ease-out;
  }

  .sm {
    height: 2.375rem;
    padding: 0 var(--cta-padding-x, 1.125rem);
    font-size: 0.9375rem;
  }

  .lg {
    height: 3rem;
    padding: 0 var(--cta-padding-x, 1.75rem);
    font-size: 1.125rem;
  }

  .primary,
  .flat {
    --cta-gradient-from: oklab(69.9% 0.067 -0.16);
    --cta-gradient-to: oklab(52.6% 0.113 -0.27);
    color: #ffffff;
  }

  .light {
    --cta-gradient-from: oklab(100% 0 0);
    --cta-gradient-to: oklab(95.5% 0 0);
    color: #1e1e1e;
    box-shadow:
      0 0 0 1px #ececec,
      0 0.0625rem 0.125rem #28282814;
  }

  .cta-button {
    background-image: linear-gradient(180deg, var(--cta-gradient-from) 0%, var(--cta-gradient-to) 100%);
    background-image: linear-gradient(180deg in oklab, var(--cta-gradient-from) 0%, var(--cta-gradient-to) 100%);
  }

  .primary {
    box-shadow:
      0 0 0 0.5rem #8b5cf640,
      0 0.0625rem 0.125rem #28282814,
      0 0 0 1px #1e1e1e40;
  }

  .flat {
    box-shadow:
      0 0.0625rem 0.125rem #28282814,
      0 0 0 1px #1e1e1e40;
  }

  .primary:hover,
  .flat:hover {
    --cta-gradient-to: oklab(33.9% 0.073 -0.174);
  }

  .primary:active,
  .flat:active {
    --cta-gradient-from: oklab(52.6% 0.113 -0.27);
    --cta-gradient-to: oklab(24.8% 0.053 -0.127);
  }

  .light:hover {
    --cta-gradient-to: oklab(89% 0 0);
  }

  .light:active {
    --cta-gradient-from: oklab(95.5% 0 0);
    --cta-gradient-to: oklab(85% 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button {
      transition: none;
    }
  }
</style>
